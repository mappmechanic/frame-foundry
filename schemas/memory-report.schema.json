{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private edit memory selection 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enabled",
    "footage_hash",
    "backend",
    "requested_backend",
    "storage_root",
    "status",
    "lessons",
    "lessons_used",
    "constraints",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "enabled": {
      "const": true
    },
    "footage_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "backend": {
      "enum": [
        "local",
        "hydradb",
        "unavailable"
      ]
    },
    "requested_backend": {
      "enum": [
        "auto",
        "local",
        "hydradb"
      ]
    },
    "storage_root": {
      "type": "string"
    },
    "status": {
      "enum": [
        "retrieved",
        "empty",
        "unavailable"
      ]
    },
    "lessons": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "infer",
          "metadata"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "text": {
            "type": "string",
            "maxLength": 400
          },
          "infer": {
            "const": false
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "lessons_used": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocked",
        "opening_types"
      ],
      "properties": {
        "blocked": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "start_ms",
              "end_ms"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "start_ms": {
                "type": "integer",
                "minimum": 0
              },
              "end_ms": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "opening_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "action",
              "family_activity",
              "interior",
              "night_parade",
              "parade",
              "people",
              "scenic_wide",
              "screen",
              "street_performers"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "write_status": {
      "type": "string"
    }
  }
}
